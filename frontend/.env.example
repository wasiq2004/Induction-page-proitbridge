# ============================================================================
# ProITBridge — Frontend Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# All vars must be prefixed with VITE_ to be exposed to the client bundle.
# ============================================================================

# --- Razorpay (payment gateway) -----------------------------------------------
# Live key starts with `rzp_live_`, test key with `rzp_test_`.
# Razorpay publishable keys are safe to ship in the client bundle.
VITE_RAZORPAY_KEY=rzp_test_XXXXXXXXXXXXXX
# Amounts are in paise. 8900 = ₹89, 100000 = ₹1000.
VITE_RAZORPAY_INDUCTION_AMOUNT=8900
VITE_RAZORPAY_ENROLLMENT_AMOUNT=100000
VITE_RAZORPAY_CURRENCY=INR
VITE_RAZORPAY_THEME_COLOR=#0B1F3A
VITE_RAZORPAY_LOGO_URL=https://aicourses.proitbridge.com/logo.png

# --- Google Apps Script endpoints (Sheets-as-backend) -------------------------
# 1) Induction access control: register / updatePayment / checkAccess
VITE_GAS_INDUCTION_URL=https://script.google.com/macros/s/REPLACE_ME/exec
# 2) Course enrollment form data → returns { status, enrollmentId, message }
VITE_GAS_ENROLLMENT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# --- n8n webhook (invoice email delivery) ------------------------------------
VITE_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/payment-invoice
VITE_INVOICE_EMAIL_RECIPIENT=ar@proitbridge.com

# --- Meta Pixel (Facebook Ads tracking) --------------------------------------
VITE_META_PIXEL_ID=

# --- Vimeo video IDs ---------------------------------------------------------
VITE_VIMEO_LANDING_VIDEO_ID=
VITE_VIMEO_INDUCTION_VIDEO_ID=

# --- Induction video (Congratulations page) ----------------------------------
# Public URL for the induction .mp4. Hosted as a GitHub Release asset so the
# file does not bloat the git repo. If unset, falls back to the local
# /assets/congrats-page-video.mp4 path (which is gitignored).
VITE_INDUCTION_VIDEO_URL=https://github.com/wasiq2004/Induction-page-proitbridge/releases/download/congrats-video-v1/congrats-page-video.mp4

# --- Company / Invoice details (used in jsPDF tax invoice) -------------------
VITE_COMPANY_NAME=PROITBRIDGE (OPC) Private Limited
VITE_COMPANY_GSTIN=29AANCP0566G1Z3
VITE_COMPANY_ADDRESS=304 AECS L/O B Block, Singasandra, Bangalore, Karnataka 560068
VITE_COMPANY_STATE=karnataka
VITE_COMPANY_EMAIL=info@proitbridge.com
VITE_COMPANY_PHONE=+91-97402 30130
VITE_COMPANY_SAC_CODE=999294

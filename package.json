{
  "name": "proitbridge",
  "private": true,
  "version": "0.1.0",
  "description": "ProITBridge — AI Career Transformation platform (frontend + backend)",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "nodemon backend/src/index.js",
    "build": "tsc --project frontend && vite build --config frontend/vite.config.ts",
    "start:backend": "node backend/src/index.js",
    "lint": "tsc --noEmit --project frontend"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "gsap": "^3.12.5",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@types/gsap": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
